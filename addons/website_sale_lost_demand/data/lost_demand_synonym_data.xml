<?xml version="1.0" encoding="utf-8"?>
<!--
Starting synonym list (Task 3.6, protocol §3): general shop vocabulary only (US/UK variants and everyday
equivalents), written without looking at the dev or test queries; frozen with the configuration (Task 8.1),
its size reported. noupdate: an upgrade never overwrites what the administrator changed. Ambiguous words are
one-way ("torch" is also a blowtorch, "tap" also a tap dance), so they only widen in the safe direction.
-->
<odoo noupdate="1">
    <record id="synonym_seed_tv" model="lost_demand.synonym">
        <field name="terms">tv, television</field>
        <field name="note">Seed (Task 3.6): general vocabulary</field>
    </record>
    <record id="synonym_seed_cell_phone" model="lost_demand.synonym">
        <field name="terms">cell phone, cellphone, mobile phone</field>
