<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds one read-only block at the end of the Website app of Settings
         (website.res_config_settings_view_form, odoo/addons/website/views/res_config_settings_views.xml). -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_sale_lost_demand</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Lost-demand search (Elasticsearch)" id="lost_demand_es_settings" groups="base.group_system">
                    <setting id="lost_demand_es_status" string="Elasticsearch status"
                             help="Read-only. Connection settings come from the server environment (.env), never from this page.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label class="col-lg-4 o_light_label" string="Reachable" for="lost_demand_es_reachable"/>
                                <field name="lost_demand_es_reachable" class="col-lg-8"/>
                            </div>
                            <div class="mt8">
                                <field name="lost_demand_es_message"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-4 o_light_label" string="Checked at" for="lost_demand_es_checked_at"/>
                                <field name="lost_demand_es_checked_at" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="lost_demand_es_cluster" string="Cluster"
                             help="Version, license (must be basic) and health of the cluster; the status is reused for 10 seconds.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label class="col-lg-4 o_light_label" string="Version" for="lost_demand_es_version"/>
                                <field name="lost_demand_es_version" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4 o_light_label" string="License" for="lost_demand_es_license"/>
                                <field name="lost_demand_es_license" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4 o_light_label" string="Health" for="lost_demand_es_health"/>
                                <field name="lost_demand_es_health" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4 o_light_label" string="Search circuit" for="lost_demand_es_circuit"/>
                                <field name="lost_demand_es_circuit" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="lost_demand_product_index" string="Product index"
                             help="Products the shop can sell, in Elasticsearch behind the alias shop-products. A rebuild loads a new index, checks the count, then moves the alias; the previous index is kept.">
                        <div class="content-group">
                            <div class="mt8">
                                <field name="lost_demand_index_message"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-4 o_light_label" string="Index" for="lost_demand_index_name"/>
                                <field name="lost_demand_index_name" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4 o_light_label" string="Documents" for="lost_demand_index_documents"/>
                                <field name="lost_demand_index_documents" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4 o_light_label" string="Products" for="lost_demand_index_products"/>
                                <field name="lost_demand_index_products" class="col-lg-8"/>
                            </div>
                            <div class="mt8">
                                <button name="action_lost_demand_rebuild_index" type="object" string="Rebuild product index"
                                        icon="oi-arrow-right" class="btn-link"
                                        confirm="Rebuild the product index now? It takes a few minutes; the shop keeps working meanwhile."/>
                            </div>
                        </div>
                    </setting>
                    <setting id="lost_demand_index_sync" string="Product changes"
                             help="Product, stock and category changes are sent to the index within a minute by the scheduled action 'Lost-demand search: sync product changes to Elasticsearch'. While Elasticsearch is down they wait here and are sent after it recovers.">
                        <div class="content-group">
                            <div class="mt8">
                                <field name="lost_demand_queue_message"/>
                            </div>
                            <div class="row mt8">
                                <label class="col-lg-4 o_light_label" string="Waiting" for="lost_demand_queue_waiting"/>
                                <field name="lost_demand_queue_waiting" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4 o_light_label" string="Refused" for="lost_demand_queue_failing"/>
                                <field name="lost_demand_queue_failing" class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4 o_light_label" string="Oldest" for="lost_demand_queue_oldest"/>
                                <field name="lost_demand_queue_oldest" class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="lost_demand_synonyms" string="Search synonyms"
                             help="Words that mean the same thing for your shoppers (sofa, couch). Rules are kept in Odoo and sent to the search within seconds, without rebuilding the index.">
                        <div class="content-group">
                            <div class="mt8">
                                <field name="lost_demand_synonyms_message"/>
                            </div>
                            <div class="mt8">
                                <button name="%(website_sale_lost_demand.action_lost_demand_synonym)d" type="action"
                                        string="Manage synonyms" class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
