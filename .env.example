# Variables of the Docker Compose stack (compose.yaml).
# Create .env with `uv run shop env init`: it copies this file and replaces every <generated> value
# with a random secret. .env is git-ignored. Never put a real secret in this file.

# --- Memory: RAM profile (docs/ai/01_ARCHITECTURE.md §5.3) ---
# standard = 16 GB laptop. For an 8 GB laptop: `uv run shop env init --profile lowmem`.
RAM_PROFILE=standard
ES_HEAP=2g
ES_MEM_LIMIT=3g
KIBANA_MEM_LIMIT=2g
ODOO_MEM_LIMIT=1536m
DB_MEM_LIMIT=1g

# --- PostgreSQL ---
POSTGRES_PASSWORD=<generated>

# --- Odoo ---
# The only database Odoo serves (created in Task 1.2). The database manager is disabled.
ODOO_DB_NAME=shop
# Odoo master password (admin_passwd).
ODOO_ADMIN_PASSWD=<generated>

# --- Elasticsearch users (docs/ai/01_ARCHITECTURE.md §5.2) ---
# Superuser: used by es-setup only, never by the module or the tools.
ELASTIC_PASSWORD=<generated>
KIBANA_SYSTEM_PASSWORD=<generated>
ODOO_APP_ES_PASSWORD=<generated>
SHOP_TOOLS_ES_PASSWORD=<generated>

# --- Kibana ---
# Your personal login for Kibana in the browser (not `elastic`).
KIBANA_PERSONAL_USER=supervisor
KIBANA_PERSONAL_PASSWORD=<generated>
KIBANA_SECURITY_KEY=<generated>
KIBANA_SAVED_OBJECTS_KEY=<generated>
KIBANA_REPORTING_KEY=<generated>
